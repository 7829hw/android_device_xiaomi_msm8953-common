allow hal_camera_default camera_data_file:sock_file write;
hal_client_domain(hal_camera_default, hal_graphics_allocator)
get_prop(hal_camera_default, camera_prop)

# Read by platform libraries linked into the HAL (libui / libgui), not needed
dontaudit hal_camera_default persist_debug_prop:file r_file_perms;
dontaudit hal_camera_default bootanim_system_prop:file r_file_perms;
